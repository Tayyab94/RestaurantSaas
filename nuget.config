<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- The <clear/> ensures no other sources from parent configs are inherited -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!-- This mapping tells NuGet that all packages should come from the source with key "nuget.org" -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>