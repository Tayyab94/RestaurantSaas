{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/restaurant-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "Database": {
    "Provider": "SqlServer",
    "ConnectionString": "Server=TAYYAB;Database=RestaurantSaaS;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Deployment": {
    "Mode": "Cloud"
  },
  "Jwt": {
    "Issuer": "RestaurantSaaS",
    "Audience": "RestaurantSaaS.Clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15
  },
  "Seed": {
    "SuperAdminUserName": "superadmin",
    "SuperAdminFullName": "Platform Administrator",
    "SuperAdminPassword": "",
    "DemoData": false,
    "DemoOwnerPassword": ""
  },
  "AllowedHosts": "*",

  "License": {
    "ServerMode": "Embedded",
    "ServerEnabled": true,
    "ServerUrl": "",
    "KeyPepper": "",
    "SigningKeyId": "k1",
    "SigningPrivateKeyPem": "",
    "SigningPrivateKeyPath": "",
    "AllowDevSigningKey": false,
    "TrustedKeys": {}
  }
}
