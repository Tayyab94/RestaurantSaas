@page "/admin/audit-log"
@attribute [Authorize(Policy = Permissions.AuditLogView)]
@inject IAuditService Audit

<PageTitle>Audit log | RestoPOS</PageTitle>

<PageHeader Title="Audit log" Subtitle="Who changed users, roles, PINs and approvals, newest first" />

<div class="card">
    <div class="card-header gap-2">
        <form class="table-search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
            <i class="bi bi-search"></i>
            <input type="search" class="form-control form-control-sm" placeholder="Search by user or action" @bind="_search" aria-label="Search the audit log" />
        </form>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger m-3" role="alert">@_error</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 data-table">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>User</th>
                        <th>What happened</th>
                        <th>Details</th>
                        <th>Address</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_result is null || _loading)
                    {
                        <tr><td colspan="5" class="text-center py-5 text-body-secondary">Loading...</td></tr>
                    }
                    else if (_result.Items.Count == 0)
                    {
                        <tr><td colspan="5"><EmptyState Icon="bi-journal-text" Title="Nothing recorded yet" /></td></tr>
                    }
                    else
                    {
                        @foreach (var item in _result.Items)
                        {
                            <tr>
                                <td class="text-body-secondary text-nowrap">@item.OccurredAt.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</td>
                                <td class="fw-semibold">@(item.UserName ?? "-")</td>
                                <td>
                                    <span class="badge text-bg-light">@Describe(item.Action)</span>
                                    <span class="text-body-secondary ms-1">@item.EntityName</span>
                                </td>
                                <td class="text-body-secondary small" style="max-width: 360px; overflow-wrap: anywhere">@Short(item.Details)</td>
                                <td class="text-body-secondary">@(item.IpAddress ?? "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer">
            <Pager Page="_page" PageSize="_pageSize" TotalCount="_result?.TotalCount ?? 0"
                   PageChanged="PageChangedAsync" PageSizeChanged="PageSizeChangedAsync" />
        </div>
    }
</div>

@code {
    private PagedResult<AuditLogItemDto>? _result;
    private string? _error;
    private bool _loading;
    private int _page = 1;
    private int _pageSize = PageRequest.DefaultPageSize;
    private string? _search;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _result = await Audit.GetPageAsync(new PageRequest(_page, _pageSize, null, true, _search));
        }
        catch (ServiceException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private Task SearchAsync()
    {
        _page = 1;
        return LoadAsync();
    }

    private Task PageChangedAsync(int page)
    {
        _page = page;
        return LoadAsync();
    }

    private Task PageSizeChangedAsync(int size)
    {
        _pageSize = size;
        _page = 1;
        return LoadAsync();
    }

    private static string Short(string? details) =>
        string.IsNullOrEmpty(details) ? string.Empty : details.Length > 160 ? details[..160] + "..." : details;

    private static string Describe(string action) => action switch
    {
        "user.created" => "User added",
        "user.pin.set" => "PIN set",
        "user.pin.removed" => "PIN removed",
        "user.password.reset" => "Password reset",
        "user.enabled" => "User enabled",
        "user.disabled" => "User disabled",
        "user.role.changed" => "Role changed",
        "user.branches.changed" => "Branches changed",
        "role.created" => "Role created",
        "role.updated" => "Role changed",
        "role.deleted" => "Role deleted",
        "approval.granted" => "Manager approval",
        _ => action,
    };
}
