@page "/admin/tenants"
@attribute [Authorize(Policy = Permissions.TenantView)]
@inject ITenantService TenantService

<PageTitle>Tenants | RestoPOS</PageTitle>

<PageHeader Title="Tenants" Subtitle="Platform administration: every customer account on this system" />

<div class="card">
    <div class="card-header gap-2">
        <form class="table-search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
            <i class="bi bi-search"></i>
            <input type="search" class="form-control form-control-sm" placeholder="Search by name or code" @bind="_search" aria-label="Search tenants" />
        </form>
        <small class="text-body-secondary ms-auto">Server-side paging, sorting and search</small>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger m-3" role="alert">@_error</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 data-table">
                <thead>
                    <tr>
                        <th><button type="button" class="sort-btn" @onclick='() => SortByAsync("code")'>Code @SortIcon("code")</button></th>
                        <th><button type="button" class="sort-btn" @onclick='() => SortByAsync("name")'>Name @SortIcon("name")</button></th>
                        <th>Business type</th>
                        <th>Status</th>
                        <th>Deployment</th>
                        <th class="text-end"><button type="button" class="sort-btn" @onclick='() => SortByAsync("createdAt")'>Created @SortIcon("createdAt")</button></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_result is null || _loading)
                    {
                        <tr><td colspan="6" class="text-center py-5 text-body-secondary">Loading...</td></tr>
                    }
                    else if (_result.Items.Count == 0)
                    {
                        <tr><td colspan="6"><EmptyState Icon="bi-buildings" Title="No tenants found" Message="Try a different search." /></td></tr>
                    }
                    else
                    {
                        @foreach (var tenant in _result.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@tenant.Code</td>
                                <td>@tenant.Name</td>
                                <td>@tenant.BusinessType</td>
                                <td><span class="badge @StatusCss(tenant.Status)">@tenant.Status</span></td>
                                <td>@tenant.DeploymentMode</td>
                                <td class="text-end text-body-secondary">@tenant.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer">
            <Pager Page="_page" PageSize="_pageSize" TotalCount="_result?.TotalCount ?? 0"
                   PageChanged="PageChangedAsync" PageSizeChanged="PageSizeChangedAsync" />
        </div>
    }
</div>

@code {
    private PagedResult<TenantDto>? _result;
    private string? _error;
    private bool _loading;
    private int _page = 1;
    private int _pageSize = PageRequest.DefaultPageSize;
    private string? _search;
    private string _sort = "createdAt";
    private bool _desc = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _result = await TenantService.GetPageAsync(new PageRequest(_page, _pageSize, _sort, _desc, _search));
        }
        catch (ServiceException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private Task SearchAsync()
    {
        _page = 1;
        return LoadAsync();
    }

    private Task SortByAsync(string column)
    {
        _desc = _sort == column && !_desc;
        _sort = column;
        _page = 1;
        return LoadAsync();
    }

    private Task PageChangedAsync(int page)
    {
        _page = page;
        return LoadAsync();
    }

    private Task PageSizeChangedAsync(int size)
    {
        _pageSize = size;
        _page = 1;
        return LoadAsync();
    }

    private MarkupString SortIcon(string column) =>
        _sort != column
            ? new MarkupString("<i class=\"bi bi-arrow-down-up sort-idle\"></i>")
            : new MarkupString(_desc ? "<i class=\"bi bi-sort-down\"></i>" : "<i class=\"bi bi-sort-up\"></i>");

    private static string StatusCss(string status) => status switch
    {
        "Active" => "text-bg-success",
        "Trial" => "text-bg-warning",
        "Suspended" => "text-bg-danger",
        _ => "text-bg-secondary",
    };
}
