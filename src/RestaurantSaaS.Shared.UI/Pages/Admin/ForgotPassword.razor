@page "/admin/forgot-password"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject IAuthService Auth
@inject ISetupService Setup
@inject NavigationManager Navigation

<PageTitle>Forgot password | RestoPOS</PageTitle>

<div class="card auth-card">
    <form class="card-body p-4 p-md-5" @onsubmit="SendAsync">
        <h1 class="auth-title">Forgot your password?</h1>
        <p class="auth-subtitle">We send a 6-digit code to the phone or email saved on your account.</p>

        @if (_sent)
        {
            <div class="alert alert-success" role="alert">
                If the account exists and has a phone number or email, a code was sent. It works for 10 minutes.
            </div>
            <a class="btn btn-primary w-100 py-2" href="@ResetLink()">I have the code</a>
            <p class="text-center text-body-secondary mt-3 mb-0">Staff without a phone or email: ask your manager for a temporary password.</p>
        }
        else
        {
            @if (_error is not null)
            {
                <div class="alert alert-danger" role="alert">@_error</div>
            }

            <div class="mb-3">
                <label class="form-label" for="business">Business code</label>
                <input id="business" class="form-control" @bind="_businessCode" />
            </div>
            <div class="mb-4">
                <label class="form-label" for="username">Username</label>
                <input id="username" class="form-control" autocomplete="username" @bind="_userName" />
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2" disabled="@_busy">@(_busy ? "Sending..." : "Send me a code")</button>
            <p class="text-center mt-4 mb-0"><a href="login">Back to sign in</a></p>
        }
    </form>
</div>

@code {
    private string? _businessCode;
    private string? _userName;
    private string? _error;
    private bool _busy;
    private bool _sent;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var status = await Setup.GetStatusAsync();
            _businessCode = status.SingleBusinessCode;
        }
        catch (ServiceException)
        {
            // Only a convenience.
        }
    }

    private async Task SendAsync()
    {
        _error = null;
        _busy = true;

        try
        {
            await Auth.RequestPasswordResetAsync(new RequestPasswordResetRequest(_businessCode ?? string.Empty, _userName ?? string.Empty));
            _sent = true;
        }
        catch (ServiceException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private string ResetLink() =>
        $"reset-password?business={Uri.EscapeDataString(_businessCode ?? string.Empty)}&user={Uri.EscapeDataString(_userName ?? string.Empty)}";
}
