@page "/admin/login-history"
@attribute [Authorize(Policy = Permissions.UserView)]
@inject IUserService UserService

<PageTitle>Login history | RestoPOS</PageTitle>

<PageHeader Title="Login history" Subtitle="Every sign-in attempt, newest first" />

<div class="card">
    <div class="card-header gap-2">
        <form class="table-search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
            <i class="bi bi-search"></i>
            <input type="search" class="form-control form-control-sm" placeholder="Search by username" @bind="_search" aria-label="Search login history" />
        </form>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger m-3" role="alert">@_error</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 data-table">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>Username</th>
                        <th>Result</th>
                        <th>Reason</th>
                        <th>Address</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_result is null || _loading)
                    {
                        <tr><td colspan="5" class="text-center py-5 text-body-secondary">Loading...</td></tr>
                    }
                    else if (_result.Items.Count == 0)
                    {
                        <tr><td colspan="5"><EmptyState Icon="bi-clock-history" Title="No sign-ins yet" /></td></tr>
                    }
                    else
                    {
                        @foreach (var item in _result.Items)
                        {
                            <tr>
                                <td class="text-body-secondary">@item.AttemptedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</td>
                                <td class="fw-semibold">@item.UserName</td>
                                <td><span class="badge @(item.IsSuccess ? "text-bg-success" : "text-bg-danger")">@(item.IsSuccess ? "Signed in" : "Failed")</span></td>
                                <td>@Describe(item.FailureReason)</td>
                                <td class="text-body-secondary">@(item.IpAddress ?? "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer">
            <Pager Page="_page" PageSize="_pageSize" TotalCount="_result?.TotalCount ?? 0"
                   PageChanged="PageChangedAsync" PageSizeChanged="PageSizeChangedAsync" />
        </div>
    }
</div>

@code {
    private PagedResult<LoginHistoryItemDto>? _result;
    private string? _error;
    private bool _loading;
    private int _page = 1;
    private int _pageSize = PageRequest.DefaultPageSize;
    private string? _search;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _result = await UserService.GetLoginHistoryAsync(new PageRequest(_page, _pageSize, null, true, _search));
        }
        catch (ServiceException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private Task SearchAsync()
    {
        _page = 1;
        return LoadAsync();
    }

    private Task PageChangedAsync(int page)
    {
        _page = page;
        return LoadAsync();
    }

    private Task PageSizeChangedAsync(int size)
    {
        _pageSize = size;
        _page = 1;
        return LoadAsync();
    }

    private static string Describe(string? reason) => reason switch
    {
        null => string.Empty,
        "wrong_password" => "Wrong password",
        "wrong_pin" => "Wrong PIN",
        "unknown_user" => "Unknown username",
        "unknown_business" => "Unknown business code",
        "no_business" => "No business code",
        "no_pin" => "No PIN set for this user",
        "disabled" => "User is disabled",
        "locked" => "Account locked",
        "tenant_suspended" => "Business not active",
        _ => reason,
    };
}
