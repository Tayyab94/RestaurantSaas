@page "/admin/reset-password"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject IAuthService Auth
@inject NavigationManager Navigation

<PageTitle>Reset password | RestoPOS</PageTitle>

<div class="card auth-card">
    <form class="card-body p-4 p-md-5" @onsubmit="ResetAsync">
        <h1 class="auth-title">Choose a new password</h1>
        <p class="auth-subtitle">Enter the 6-digit code you received.</p>

        @if (_error is not null)
        {
            <div class="alert alert-danger" role="alert">
                @_error
                @if (_fieldErrors.Count > 0)
                {
                    <ul class="mb-0 mt-2">
                        @foreach (var message in _fieldErrors)
                        {
                            <li>@message</li>
                        }
                    </ul>
                }
            </div>
        }

        <div class="mb-3">
            <label class="form-label" for="business">Business code</label>
            <input id="business" class="form-control" @bind="_businessCode" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="username">Username</label>
            <input id="username" class="form-control" autocomplete="username" @bind="_userName" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="code">Code</label>
            <input id="code" class="form-control" inputmode="numeric" maxlength="6" autocomplete="one-time-code" @bind="_code" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="pass">New password</label>
            <input id="pass" type="password" class="form-control" autocomplete="new-password" @bind="_password" />
            <div class="form-text">At least 8 characters with upper-case, lower-case and a digit.</div>
        </div>
        <div class="mb-4">
            <label class="form-label" for="pass2">Confirm new password</label>
            <input id="pass2" type="password" class="form-control" autocomplete="new-password" @bind="_confirm" />
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2" disabled="@_busy">@(_busy ? "Saving..." : "Change password")</button>
        <p class="text-center mt-4 mb-0"><a href="forgot-password">Send a new code</a> | <a href="login">Back to sign in</a></p>
    </form>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Business { get; set; }

    [SupplyParameterFromQuery]
    public string? User { get; set; }

    private string? _businessCode;
    private string? _userName;
    private string? _code;
    private string? _password;
    private string? _confirm;
    private string? _error;
    private List<string> _fieldErrors = [];
    private bool _busy;

    protected override void OnInitialized()
    {
        _businessCode = Business;
        _userName = User;
    }

    private async Task ResetAsync()
    {
        _error = null;
        _fieldErrors = [];

        if (_password != _confirm)
        {
            _error = "The two passwords are not the same.";
            return;
        }

        _busy = true;

        try
        {
            await Auth.ResetPasswordAsync(new ResetPasswordRequest(
                _businessCode ?? string.Empty, _userName ?? string.Empty, _code ?? string.Empty, _password ?? string.Empty));

            Navigation.NavigateTo("login?changed=1", replace: true);
        }
        catch (ServiceException ex)
        {
            _error = ex.Message;
            _fieldErrors = ex.Errors.SelectMany(e => e.Value).ToList();
        }
        finally
        {
            _busy = false;
        }
    }
}
