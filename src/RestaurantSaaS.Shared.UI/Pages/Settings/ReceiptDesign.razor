@page "/settings/receipt"
@attribute [Authorize(Policy = Permissions.SettingsView)]
@inject ISettingsService Settings
@inject AuthSession Session

<PageTitle>Receipt design | RestoPOS</PageTitle>

<PageHeader Title="Receipt design" Subtitle="What is printed on invoices and kitchen tickets">
    @if (CanManage)
    {
        <button type="button" class="btn btn-primary btn-sm" @onclick="StartNew"><i class="bi bi-plus-lg"></i> New template</button>
    }
</PageHeader>

@if (_message is not null)
{
    <div class="alert alert-success" role="alert">@_message</div>
}

@if (_error is not null)
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

<div class="row g-3">
    <div class="col-lg-7">
        @if (_editing)
        {
            <form class="card mb-3" @onsubmit="SaveAsync">
                <div class="card-body">
                    <h2 class="h5 mb-3">@(_editId is null ? "New template" : "Edit template")</h2>

                    @if (_formError is not null)
                    {
                        <div class="alert alert-danger" role="alert">
                            @_formError
                            @if (_fieldErrors.Count > 0)
                            {
                                <ul class="mb-0 mt-2">
                                    @foreach (var message in _fieldErrors)
                                    {
                                        <li>@message</li>
                                    }
                                </ul>
                            }
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="r-name">Template name</label>
                            <input id="r-name" class="form-control" @bind="_name" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="r-doc">Document</label>
                            <select id="r-doc" class="form-select" @bind="_documentType">
                                <option value="Invoice">Invoice</option>
                                <option value="Kot">Kitchen ticket</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="r-lang">Language</label>
                            <select id="r-lang" class="form-select" @bind="_language">
                                <option value="en">English</option>
                                <option value="ur">Urdu</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="r-head">Header text</label>
                            <textarea id="r-head" class="form-control" rows="2" @bind="_headerText" placeholder="For example: Welcome to our restaurant"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="r-foot">Footer text</label>
                            <textarea id="r-foot" class="form-control" rows="2" @bind="_footerText" placeholder="For example: Thank you, visit again"></textarea>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check">
                                <input id="r-logo" class="form-check-input" type="checkbox" @bind="_showLogo" />
                                <label class="form-check-label" for="r-logo">Print the logo</label>
                            </div>
                            <div class="form-check">
                                <input id="r-qr" class="form-check-input" type="checkbox" @bind="_showQr" />
                                <label class="form-check-label" for="r-qr">Print a QR code</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check">
                                <input id="r-tax" class="form-check-input" type="checkbox" @bind="_showTaxBreakdown" />
                                <label class="form-check-label" for="r-tax">Show the tax breakdown</label>
                            </div>
                            <div class="form-check">
                                <input id="r-trial" class="form-check-input" type="checkbox" @bind="_showTrialMark" />
                                <label class="form-check-label" for="r-trial">Print a trial mark while on trial</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary btn-sm" disabled="@_saving">@(_saving ? "Saving..." : "Save template")</button>
                    <button type="button" class="btn btn-link btn-sm" @onclick="Cancel">Close</button>
                </div>
            </form>
        }

        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 data-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Document</th>
                            <th>Language</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_templates is null)
                        {
                            <tr><td colspan="4" class="text-center py-5 text-body-secondary">Loading...</td></tr>
                        }
                        else if (_templates.Count == 0)
                        {
                            <tr><td colspan="4"><EmptyState Icon="bi-printer" Title="No templates" Message="Add a template to design your receipts." /></td></tr>
                        }
                        else
                        {
                            @foreach (var template in _templates)
                            {
                                <tr>
                                    <td class="fw-semibold">@template.Name</td>
                                    <td>@(template.DocumentType == "Kot" ? "Kitchen ticket" : "Invoice")</td>
                                    <td>@(template.Language == "ur" ? "Urdu" : "English")</td>
                                    <td class="text-end">
                                        @if (CanManage)
                                        {
                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => Edit(template)">Edit</button>
                                            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => DeleteAsync(template)">Delete</button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-body">
                <h2 class="h5 mb-3">Preview</h2>
                <div class="border rounded p-3 mx-auto" style="max-width: 300px; font-family: monospace; font-size: 0.85rem;" dir="@(_language == "ur" ? "rtl" : "ltr")">
                    @if (_showTrialMark)
                    {
                        <div class="text-center fw-bold">** TRIAL **</div>
                    }

                    @if (_showLogo && !string.IsNullOrEmpty(_logo) && _logo.StartsWith("data:image/", StringComparison.Ordinal))
                    {
                        <div class="text-center mb-2"><img src="@_logo" alt="Logo" style="max-height: 60px; max-width: 100%;" /></div>
                    }

                    <div class="text-center fw-bold">@_businessName</div>
                    @if (!string.IsNullOrWhiteSpace(_businessAddress))
                    {
                        <div class="text-center">@_businessAddress</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_headerText))
                    {
                        <div class="text-center mt-1" style="white-space: pre-line;">@_headerText</div>
                    }

                    <hr class="my-2" />
                    <div>@(_documentType == "Kot" ? "KOT-0001" : "INV-000001")</div>
                    <div class="d-flex justify-content-between"><span>2 x Chicken Karahi</span>@if (_documentType != "Kot") { <span>2,400</span> }</div>
                    <div class="d-flex justify-content-between"><span>1 x Naan</span>@if (_documentType != "Kot") { <span>60</span> }</div>

                    @if (_documentType != "Kot")
                    {
                        <hr class="my-2" />
                        <div class="d-flex justify-content-between"><span>Subtotal</span><span>2,460</span></div>
                        @if (_showTaxBreakdown)
                        {
                            <div class="d-flex justify-content-between"><span>GST 16%</span><span>394</span></div>
                        }
                        <div class="d-flex justify-content-between fw-bold"><span>Total</span><span>@(_showTaxBreakdown ? "2,854" : "2,460")</span></div>
                    }

                    @if (_showQr)
                    {
                        <div class="text-center my-2 border mx-auto d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">QR</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_footerText))
                    {
                        <hr class="my-2" />
                        <div class="text-center" style="white-space: pre-line;">@_footerText</div>
                    }
                </div>
                <div class="form-text mt-2">A sample. Real printing comes with the printing module.</div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ReceiptTemplateDto>? _templates;
    private bool _editing;
    private bool _saving;
    private string? _message;
    private string? _error;
    private string? _formError;
    private List<string> _fieldErrors = [];

    private string _businessName = string.Empty;
    private string? _businessAddress;
    private string? _logo;

    private Guid? _editId;
    private string _name = string.Empty;
    private string _documentType = "Invoice";
    private string _language = "en";
    private string? _headerText;
    private string? _footerText;
    private bool _showLogo = true;
    private bool _showQr;
    private bool _showTaxBreakdown = true;
    private bool _showTrialMark = true;

    private bool CanManage => Session.Has(Permissions.SettingsManage);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var profile = await Settings.GetBusinessProfileAsync();
            _businessName = profile.Name;
            _businessAddress = profile.Address;
            _logo = profile.LogoDataUri;
        }
        catch (ServiceException)
        {
            // The preview works without the business details.
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _templates = (await Settings.GetReceiptTemplatesAsync()).ToList();
        }
        catch (ServiceException ex)
        {
            _error = ex.Message;
            _templates ??= [];
        }
    }

    private void StartNew()
    {
        Reset();
        _editing = true;
    }

    private void Edit(ReceiptTemplateDto template)
    {
        Reset();
        _editing = true;
        _editId = template.Id;
        _name = template.Name;
        _documentType = template.DocumentType;
        _language = template.Language;
        _headerText = template.HeaderText;
        _footerText = template.FooterText;
        _showLogo = template.ShowLogo;
        _showQr = template.ShowQr;
        _showTaxBreakdown = template.ShowTaxBreakdown;
        _showTrialMark = template.ShowTrialMark;
    }

    private void Reset()
    {
        _message = null;
        _error = null;
        _formError = null;
        _fieldErrors = [];
        _editId = null;
        _name = string.Empty;
        _documentType = "Invoice";
        _language = "en";
        _headerText = null;
        _footerText = null;
        _showLogo = true;
        _showQr = false;
        _showTaxBreakdown = true;
        _showTrialMark = true;
    }

    private void Cancel() => _editing = false;

    private async Task SaveAsync()
    {
        _formError = null;
        _fieldErrors = [];
        _saving = true;

        try
        {
            var isNew = _editId is null;

            await Settings.SaveReceiptTemplateAsync(new SaveReceiptTemplateRequest(
                _editId, _name, _documentType, _language, _headerText, _footerText,
                _showLogo, _showQr, _showTaxBreakdown, _showTrialMark));

            _message = isNew ? "The template was added." : "The template was saved.";
            _editing = false;
            await LoadAsync();
        }
        catch (ServiceException ex)
        {
            _formError = ex.Message;
            _fieldErrors = ex.Errors.SelectMany(e => e.Value).ToList();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync(ReceiptTemplateDto template)
    {
        _message = null;
        _error = null;

        try
        {
            await Settings.DeleteReceiptTemplateAsync(template.Id);
            _message = $"The template {template.Name} was deleted.";
            await LoadAsync();
        }
        catch (ServiceException ex)
        {
            _error = ex.Message;
        }
    }
}
