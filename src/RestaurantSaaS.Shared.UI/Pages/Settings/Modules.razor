@page "/settings/modules"
@attribute [Authorize(Policy = Permissions.SettingsView)]
@inject ISettingsService Settings
@inject AuthSession Session
@inject ModuleState moduleState

<PageTitle>Modules | RestoPOS</PageTitle>

<PageHeader Title="Modules" Subtitle="Switch off what your business does not use. Switched-off modules are hidden from the menu." />

@if (_message is not null)
{
    <div class="alert alert-success" role="alert">@_message</div>
}

@if (_error is not null)
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

@if (_loading)
{
    <div class="text-body-secondary py-4">Loading...</div>
}
else
{
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5 mb-3">Module switches</h2>

                    @foreach (var module in _switches)
                    {
                        <div class="form-check form-switch mb-3">
                            <input id="@($"m-{module.Key}")" class="form-check-input" type="checkbox" role="switch"
                                   checked="@module.IsEnabled" disabled="@(!CanManage)"
                                   @onchange="e => module.IsEnabled = (bool)(e.Value ?? false)" />
                            <label class="form-check-label fw-semibold" for="@($"m-{module.Key}")">@module.Name</label>
                            <div class="form-text">@module.Description</div>
                        </div>
                    }
                </div>
                @if (CanManage)
                {
                    <div class="card-footer">
                        <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="SaveAsync">@(_busy ? "Saving..." : "Save")</button>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5 mb-1">Business type</h2>
                    <div class="form-text mb-3">A business type sets the starting switches. Applying one replaces your current switches.</div>

                    @if (CurrentTemplate is { } current)
                    {
                        <div class="d-flex justify-content-between align-items-center border rounded p-2 mb-3 @(IsChangedFromDefault ? "border-warning" : string.Empty)">
                            <div class="small">
                                Your business type is <span class="fw-semibold">@current.Name</span>.
                                @(IsChangedFromDefault ? "Your switches differ from its defaults." : "Your switches match its defaults.")
                            </div>
                            @if (CanManage)
                            {
                                <button type="button" class="btn btn-outline-primary btn-sm" disabled="@_busy" @onclick="() => ResetAsync(current)">
                                    Reset to defaults
                                </button>
                            }
                        </div>
                    }

                    @foreach (var template in _templates)
                    {
                        <div class="d-flex justify-content-between align-items-start border rounded p-2 mb-2">
                            <div>
                                <div class="fw-semibold">@template.Name @(template.IsCurrent ? "(current)" : string.Empty)</div>
                                <div class="small text-body-secondary">@template.Description</div>
                            </div>
                            @if (CanManage && !template.IsCurrent)
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick="() => ApplyAsync(template)">Apply</button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private sealed class SwitchRow(ModuleSwitchDto source)
    {
        public string Key { get; } = source.Key;

        public string Name { get; } = source.Name;

        public string Description { get; } = source.Description;

        public bool IsEnabled { get; set; } = source.IsEnabled;
    }

    private bool _loading = true;
    private bool _busy;
    private string? _message;
    private string? _error;
    private List<SwitchRow> _switches = [];
    private IReadOnlyList<BusinessTemplateDto> _templates = [];

    private bool CanManage => Session.Has(Permissions.SettingsManage);

    private BusinessTemplateDto? CurrentTemplate => _templates.FirstOrDefault(t => t.IsCurrent);

    // True when a switch (saved or just changed on screen) is different from the default of the current business type.
    private bool IsChangedFromDefault =>
        CurrentTemplate is { } template
        && template.Modules.Any(m => _switches.Any(s => s.Key == m.Key && s.IsEnabled != m.IsEnabled));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadAsync();
        }
        catch (ServiceException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadAsync()
    {
        _switches = (await Settings.GetModuleSwitchesAsync()).Select(m => new SwitchRow(m)).ToList();
        _templates = await Settings.GetBusinessTemplatesAsync();
    }

    private async Task SaveAsync()
    {
        _message = null;
        _error = null;
        _busy = true;

        try
        {
            await Settings.SaveModuleSwitchesAsync(new SaveModuleSwitchesRequest(
                _switches.Select(s => new ModuleSwitchChangeDto(s.Key, s.IsEnabled)).ToList()));

            await moduleState.RefreshAsync();
            _message = "The module switches were saved.";
        }
        catch (ServiceException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ResetAsync(BusinessTemplateDto template)
    {
        _message = null;
        _error = null;

        if (!IsChangedFromDefault)
        {
            _message = $"Nothing to reset. Your switches already match the {template.Name} defaults.";
            return;
        }

        _busy = true;

        try
        {
            // Applying the current template again puts its default switches back.
            await Settings.ApplyBusinessTemplateAsync(template.Code);
            await LoadAsync();
            await moduleState.RefreshAsync();
            _message = $"The switches were reset to the {template.Name} defaults.";
        }
        catch (ServiceException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ApplyAsync(BusinessTemplateDto template)
    {
        _message = null;
        _error = null;
        _busy = true;

        try
        {
            await Settings.ApplyBusinessTemplateAsync(template.Code);
            await LoadAsync();
            await moduleState.RefreshAsync();
            _message = $"The {template.Name} template was applied.";
        }
        catch (ServiceException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
