@page "/account/change-password"
@inject IAuthService Auth
@inject AuthSession Session
@inject NavigationManager Navigation

<PageTitle>Change password | RestoPOS</PageTitle>

<PageHeader Title="Change password" Subtitle="Choose a new password. You will be signed out on all devices." />

<div class="card" style="max-width: 520px">
    <form class="card-body" @onsubmit="ChangeAsync">
        @if (_error is not null)
        {
            <div class="alert alert-danger" role="alert">
                @_error
                @if (_fieldErrors.Count > 0)
                {
                    <ul class="mb-0 mt-2">
                        @foreach (var message in _fieldErrors)
                        {
                            <li>@message</li>
                        }
                    </ul>
                }
            </div>
        }

        <div class="mb-3">
            <label class="form-label" for="current">Current password</label>
            <input id="current" type="password" class="form-control" autocomplete="current-password" @bind="_current" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="new">New password</label>
            <input id="new" type="password" class="form-control" autocomplete="new-password" @bind="_new" />
            <div class="form-text">At least 8 characters with upper-case, lower-case and a digit.</div>
        </div>
        <div class="mb-4">
            <label class="form-label" for="confirm">Confirm new password</label>
            <input id="confirm" type="password" class="form-control" autocomplete="new-password" @bind="_confirm" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@_busy">@(_busy ? "Saving..." : "Change password")</button>
    </form>
</div>

@code {
    private string? _current;
    private string? _new;
    private string? _confirm;
    private string? _error;
    private List<string> _fieldErrors = [];
    private bool _busy;

    private async Task ChangeAsync()
    {
        _error = null;
        _fieldErrors = [];

        if (_new != _confirm)
        {
            _error = "The two new passwords are not the same.";
            return;
        }

        _busy = true;

        try
        {
            await Auth.ChangePasswordAsync(new ChangePasswordRequest(_current ?? string.Empty, _new ?? string.Empty));
            await Session.SignOutAsync();
            Navigation.NavigateTo("login?changed=1", replace: true);
        }
        catch (ServiceException ex)
        {
            _error = ex.Message;
            _fieldErrors = ex.Errors.SelectMany(e => e.Value).ToList();
        }
        finally
        {
            _busy = false;
        }
    }
}
