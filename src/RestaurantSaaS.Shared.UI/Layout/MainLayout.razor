@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeService Theme
@inject AuthSession Session
@inject IPreferenceService Prefs
@inject NavigationManager Navigation

@if (!Session.IsAuthenticated)
{
    @* Not signed in (or still restoring the session): show only the page, which redirects to the sign-in screen. *@
    @Body
}
else
{
<div class="app-shell @ShellClass">
    <IdleGuard />
    <aside class="app-sidebar" aria-label="Main navigation">
        <div class="sidebar-brand">
            <span class="brand-mark"><i class="bi bi-fire"></i></span>
            <span class="brand-text">Resto<span>POS</span></span>
        </div>

        <NavMenu OnNavigate="CloseMobile" />

        <div class="sidebar-footer">
            @* Static placeholder: replaced by the real license state in module M04. *@
                <div class="sidebar-footer">
                    <LicenseCard />
                </div>
        </div>
    </aside>

    <div class="app-backdrop" @onclick="CloseMobile"></div>

    <div class="app-main">
        <header class="app-topbar">
            <button type="button" class="btn btn-icon" @onclick="ToggleSidebar" aria-label="Toggle navigation">
                <i class="bi bi-list"></i>
            </button>

            <div class="topbar-search">
                <i class="bi bi-search"></i>
                <input type="search" class="form-control" placeholder="Search orders, items, customers..." aria-label="Search" />
            </div>

            <div class="topbar-actions">
                <span class="btn branch-pill d-none d-md-inline-block">
                    <i class="bi bi-shop me-1"></i> @(Session.User?.TenantName ?? "Platform")
                </span>

                <button type="button" class="btn btn-icon" @onclick="ToggleTheme" aria-label="Toggle dark mode">
                    <i class="bi @(_dark ? "bi-sun" : "bi-moon-stars")"></i>
                </button>

                <button type="button" class="btn btn-icon position-relative" aria-label="Notifications">
                    <i class="bi bi-bell"></i>
                    <span class="notif-dot"></span>
                </button>

                <div class="dropdown">
                    <button class="btn user-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="avatar">@Initials</span>
                        <span class="d-none d-md-inline">@(Session.User?.FullName ?? "Guest")</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li>
                            <h6 class="dropdown-header">@Session.User?.UserName</h6>
                            <div class="dropdown-item-text small text-body-secondary">@RoleText</div>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" href="account/preferences"><i class="bi bi-sliders me-2"></i>Preferences</a></li>
                        <li><a class="dropdown-item" href="account/change-password"><i class="bi bi-shield-lock me-2"></i>Change password</a></li>
                        <li><button type="button" class="dropdown-item" @onclick="SignOutAsync"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button></li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="app-content">
            @if (Session.User?.MustChangePassword == true)
            {
                <div class="alert alert-warning d-flex align-items-center gap-2" role="alert">
                    <i class="bi bi-exclamation-triangle"></i>
                    <span>You are using a temporary password. Please change it now.</span>
                    <a class="btn btn-sm btn-warning ms-auto" href="account/change-password">Change password</a>
                </div>
            }

                <LicenseLock />
                <LicenseBanner />

            @Body
        </main>
    </div>
</div>
}

@code {
    private bool _collapsed;
    private bool _mobileOpen;
    private bool _dark;
    private bool _prefsApplied;
    private string _language = "en";

    private string ShellClass => $"{(_collapsed ? "is-collapsed" : string.Empty)} {(_mobileOpen ? "is-open" : string.Empty)}".Trim();

    private string Initials
    {
        get
        {
            var name = Session.User?.FullName;
            if (string.IsNullOrWhiteSpace(name))
            {
                return "?";
            }

            var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return parts.Length == 1 ? parts[0][..1].ToUpperInvariant() : $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
        }
    }

    private string RoleText => Session.User is null
        ? string.Empty
        : Session.User.IsSuperAdmin ? "Platform administrator" : string.Join(", ", Session.User.Roles);

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        Theme.Changed += OnThemeChanged;

        // Restore the stored session first. Nobody sees this layout without being signed in:
        // if there is no session, go to the sign-in screen and come back to this page afterwards.
        await Session.InitializeAsync();
        RedirectIfSignedOut();
    }

    private void OnSessionChanged()
    {
        RedirectIfSignedOut();
        _ = InvokeAsync(StateHasChanged);
    }

    private void RedirectIfSignedOut()
    {
        if (Session.IsAuthenticated)
        {
            return;
        }

        var returnUrl = Uri.EscapeDataString(ReturnUrlHelper.Resolve(Navigation.ToBaseRelativePath(Navigation.Uri)));
        Navigation.NavigateTo($"login?returnUrl={returnUrl}", replace: true);
    }

    private void OnThemeChanged(bool dark)
    {
        _dark = dark;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Theme.Changed -= OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dark = await Theme.InitializeAsync();
            StateHasChanged();
        }

        if (Session.IsAuthenticated && !_prefsApplied)
        {
            _prefsApplied = true;
            await ApplyPreferencesAsync();
            StateHasChanged();
        }
    }

    // The saved choice of the signed-in user wins over what this browser or PC remembers. "Auto" means nothing was saved yet.
    private async Task ApplyPreferencesAsync()
    {
        try
        {
            var preferences = await Prefs.GetAsync();
            _language = preferences.Language;

            if (preferences.Theme is "Light" or "Dark")
            {
                _dark = preferences.Theme == "Dark";
                await Theme.SetDarkAsync(_dark);
            }
        }
        catch (ServiceException)
        {
            // The preferences are a convenience; keep the local theme.
        }
    }

    private void ToggleSidebar()
    {
        // The same button collapses the sidebar on desktop and opens it on small screens.
        _collapsed = !_collapsed;
        _mobileOpen = !_mobileOpen;
    }

    private void CloseMobile() => _mobileOpen = false;

    private async Task ToggleTheme()
    {
        _dark = !_dark;
        await Theme.SetDarkAsync(_dark);

        try
        {
            await Prefs.SaveAsync(new UserPreferencesDto(_dark ? "Dark" : "Light", _language));
        }
        catch (ServiceException)
        {
            // Not saved on the server; the choice still applies on this device.
        }
    }

    private async Task SignOutAsync()
    {
        await Session.SignOutAsync();
        Navigation.NavigateTo("login", replace: true);
    }
}
