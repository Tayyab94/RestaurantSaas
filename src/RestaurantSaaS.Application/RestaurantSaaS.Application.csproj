<Project Sdk="Microsoft.NET.Sdk">
  <!-- Use cases, handlers, validators and abstractions. Pragmatic clean architecture:
       it references EF Core abstractions for IQueryable/DbSet, but never a database provider. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RestaurantSaaS.Application</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RestaurantSaaS.Contracts\RestaurantSaaS.Contracts.csproj" />
    <ProjectReference Include="..\RestaurantSaaS.Domain\RestaurantSaaS.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RestaurantSaaS.UnitTests" />
  </ItemGroup>
</Project>
